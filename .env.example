# ── Admin authentication ──────────────────────────────────────────────────────
ADMIN_EMAIL=admin@smartspacepicks.com
ADMIN_PASSWORD=change-this-in-production

# Session encryption key — must be at least 32 characters
SESSION_SECRET=change-this-32-char-secret-in-production

# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API

# Project URL (safe to expose in browser bundles)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Service role secret key — server-only, NEVER expose in client code
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Site ──────────────────────────────────────────────────────────────────────
# Production URL without trailing slash. Used for canonical URLs, OG images,
# and sitemap generation. Defaults to https://www.smartspacepicks.com if unset.
NEXT_PUBLIC_SITE_URL=https://www.smartspacepicks.com


# ── Cron jobs ─────────────────────────────────────────────────────────────────
# Secret used to authenticate Vercel cron requests (set in Vercel dashboard too)
CRON_SECRET=change-this-cron-secret

# IndexNow key for Bing/Yandex auto-ping. Must match the filename in /public/.
# Default: c98c7bf07f814a3b85155692e78cbbfc (file already present in public/)
INDEXNOW_KEY=c98c7bf07f814a3b85155692e78cbbfc

# ── Amazon Creators API (product data sync) ────────────────────────────────────
# Associates Central → Tools → CreatorsAPI → Applications → Add new credential
# Credential ID (replaces old PA API Access Key)
AMAZON_PAAPI_ACCESS_KEY=amzn1.application-oa2-client.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Credential Secret — only shown once at creation, store securely
AMAZON_PAAPI_SECRET_KEY=amzn1.oa2-cs.v1.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your Amazon Associates partner tag
AMAZON_PAAPI_PARTNER_TAG=yourtag-20
